# Copy this file to .env and fill in your key(s).
# ScrapeGraphAI's graphs use an LLM to read scraped pages and extract
# structured data, so at least one LLM API key is required.

# OpenAI (recommended default, used by the leads_finder.py example)
OPENAI_API_KEY=

# Optional alternatives supported by scrapegraphai:
# MISTRAL_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
